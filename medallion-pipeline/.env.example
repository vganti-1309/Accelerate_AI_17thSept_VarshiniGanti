# Select the AI provider used by the pipeline.
# Supported values: anthropic, groq, gemini, openai, github
LLM_PROVIDER=anthropic

# Primary provider: get your Claude API key from:
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Pinned Claude model used by default for structured JSON generation.
# Other options: claude-sonnet-5, claude-opus-5
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional provider: get your Groq API key from:
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Other options: openai/gpt-oss-120b, llama-3.1-8b-instant, llama-3.3-70b-versatile
# The openai/gpt-oss models are reasoning models; configure Groq calls to hide reasoning
# before parsing their responses as JSON.
GROQ_MODEL=openai/gpt-oss-20b

# Optional provider: get your Google Gemini API key from:
# https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Optional provider: get your OpenAI API key from:
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional provider: create a GitHub token from:
# https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here
GITHUB_MODEL=openai/gpt-4.1-mini